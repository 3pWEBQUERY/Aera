// Aera.so — Multi-Tenant Creator Platform
// Prisma 7 (Rust-free, prisma-client generator + pg driver adapter)

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url is configured in prisma.config.ts (Prisma 7)
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------
enum Role {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum MemberStatus {
  ACTIVE
  PENDING
  BANNED
}

enum PlatformRole {
  USER
  ADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETING
}

enum SpaceType {
  FEED
  FORUM
  COURSE
  SHOP
  NEWSLETTER
  EVENTS
  BLOG
  KNOWLEDGE
  GALLERY
  VIDEOS
  CHAT
  PODCAST
  /// Musik: Titel mit Cover und Player. Audio liegt wie beim Podcast in
  /// `videoUrl`, das Cover in `imageUrl` — dieselbe Beitragsform, andere Buehne.
  MUSIC
  LINKS
  ADS
  LIVE
  REQUESTS
  BOOKING
  STORIES
  TIPS
  CALENDAR
}

enum Visibility {
  PUBLIC // anyone, even logged out
  MEMBERS // any logged-in member of the tenant
  PAID // requires a tier/entitlement
}

enum BillingInterval {
  FREE
  MONTH
  YEAR
  ONE_TIME
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum StripeWebhookStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  RETRYING
  DELIVERED
  EXHAUSTED
}

enum AutomationDeliveryStatus {
  PENDING
  PROCESSING
  RETRYING
  SENT
  SUPPRESSED
  EXHAUSTED
}

enum NewsletterDeliveryStatus {
  PENDING
  PROCESSING
  RETRYING
  SENT
  SUPPRESSED
  EXHAUSTED
}

enum NewsletterConsentStatus {
  OPTED_IN
  WITHDRAWN
}

enum NewsletterConsentEventType {
  OPTED_IN
  WITHDRAWN
}

enum EmailSuppressionReason {
  UNSUBSCRIBED
  BOUNCE
  COMPLAINT
  MANUAL
}

enum CronJobStatus {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
}

enum AccountStatus {
  ACTIVE
  DELETING
  DELETED
}

enum DataDeletionScope {
  TENANT
  USER
}

enum DataDeletionStatus {
  PENDING
  PROCESSING
  RETRYING
  BLOCKED
  COMPLETED
}

enum ObjectDeletionStatus {
  PENDING
  PROCESSING
  RETRYING
  COMPLETED
  EXHAUSTED
}

enum AiCreditReservationStatus {
  RESERVED
  SETTLED
  RELEASED
}

enum AiCreditSource {
  INCLUDED
  PURCHASED
}

enum EntitlementSource {
  TIER
  PURCHASE
  MANUAL
  ROLE
}

enum ProductType {
  DIGITAL
  PHYSICAL
  BUNDLE
  COURSE_ACCESS
  TIER_GRANT
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
}

enum CampaignBodyFormat {
  TEXT
  HTML
}

enum EmailEventType {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  SUPPRESSED
  FAILED
}

enum GamificationTrigger {
  POST_CREATED
  COMMENT_CREATED
  REACTION_GIVEN
  LESSON_COMPLETED
  EVENT_RSVP
  DAILY_LOGIN
  PURCHASE
  REFERRAL // ein geworbenes Mitglied ist beigetreten
  TIP // Trinkgeld gegeben
}

enum RsvpStatus {
  GOING
  INTERESTED
  NOT_GOING
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
}

/// Woher das Bild kommt: AERA = der Creator sendet an Aera (Cloudflare Stream),
/// EXTERNAL = eingebetteter Stream einer fremden Plattform.
enum LiveSource {
  EXTERNAL
  AERA
}

/// Womit gesendet wird. BROWSER = Kamera/Bildschirm direkt aus der Seite
/// (WebRTC/WHIP, unter einer Sekunde Verzögerung, ohne Aufzeichnung),
/// OBS = Sendesoftware über RTMPS (mit Aufzeichnung, einige Sekunden Versatz).
enum LiveIngest {
  BROWSER
  OBS
}

enum StorageVisibility {
  PUBLIC
  MEMBERS
  PAID
}

enum StorageUploadStatus {
  RESERVED
  COMPLETED
  FAILED
  EXPIRED
}

// Creator subscription package — determines the monthly AI credit allowance.
enum CreatorPlan {
  FREE
  STARTER
  PRO
  SCALE
}

// Where a tenant's current package comes from. PROMO plans are granted by an
// influencer/partner code and expire on their own schedule; STRIPE plans are
// owned by the billing webhooks and must never be overwritten by a code.
enum CreatorPlanSource {
  DEFAULT
  STRIPE
  PROMO
  /// Von einem Plattform-Admin vergeben. Wird wie FREE/PROMO lokal
  /// aufgefuellt (es gibt keine Rechnung) und laeuft nie von selbst ab.
  MANUAL
}

enum CreatorCheckoutStatus {
  CREATING
  OPEN
  COMPLETED
  EXPIRED
  FAILED
}

// ----------------------------------------------------------------------------
// Global (tenant-neutral) identity
// ----------------------------------------------------------------------------
model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String
  name            String
  avatarUrl       String?
  /// Set once the user proved control of their mailbox (verification link,
  /// accepted invite, or completed password reset). Null = unverified.
  emailVerifiedAt DateTime?
  /// Zwei-Faktor (TOTP, RFC 6238): Base32-Secret; gesetzt ab Einrichtung.
  totpSecret      String?
  /// 2FA aktiv ab diesem Zeitpunkt (nach bestätigtem Einrichtungs-Code).
  totpEnabledAt   DateTime?
  /// Incrementing this invalidates every previously issued session token.
  sessionVersion  Int           @default(0)
  /// Plattformweite Berechtigung. ADMIN ist nur zusammen mit verifizierter
  /// E-Mail und aktivem TOTP wirksam (siehe lib/platform-admin.ts).
  platformRole    PlatformRole  @default(USER)
  /// DELETING/DELETED identities cannot authenticate. Deletion jobs keep a
  /// pseudonymous tombstone where billing/content foreign keys require one.
  accountStatus   AccountStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberships               Membership[]
  ownedTenants              Tenant[]                   @relation("TenantOwner")
  posts                     Post[]
  comments                  Comment[]
  reactions                 Reaction[]
  orders                    Order[]
  subscriptions             Subscription[]
  entitlements              Entitlement[]
  pointsLedger              PointsLedger[]
  badgeAwards               BadgeAward[]
  memberStats               MemberStats[]
  lessonProgress            LessonProgress[]
  eventRsvps                EventRsvp[]
  liveMessages              LiveChatMessage[]
  recommendations           Recommendation[]
  emailEvents               EmailEvent[]
  storageObjects            StorageObject[]
  storageUploadReservations StorageUploadReservation[]
  campaigns                 NewsletterCampaign[]
  automationDeliveries      AutomationDelivery[]
  chatMessages              ChatMessage[]
  conversationMembers       ConversationMember[]
  assistantConversations    AssistantConversation[]
  memberRequests            MemberRequest[]
  requestVotes              RequestVote[]
  contentPlans              ContentPlan[]
  bookingReservations       BookingReservation[]
  stories                   Story[]
  tips                      Tip[]
  notifications             Notification[]             @relation("NotificationRecipient")
  notificationsTriggered    Notification[]             @relation("NotificationActor")
  pushSubscriptions         PushSubscription[]
  newsletterDeliveries      NewsletterDelivery[]
  newsletterConsents        NewsletterConsent[]
  newsletterConsentEvents   NewsletterConsentEvent[]
  emailSuppressions         EmailSuppression[]
  pendingCreatorCheckouts   PendingCreatorCheckout[]
  legalAcceptances          LegalAcceptance[]
  pollVotes                 PollVote[]
  promoCodesCreated         PromoCode[]                @relation("PromoCodeAuthor")
  promoRedemptions          PromoCodeRedemption[]
  platformSeoEdits          PlatformSeo[]              @relation("PlatformSeoEditor")
  platformPosts             PlatformPost[]             @relation("PlatformPostAuthor")
  supportTickets            SupportTicket[]            @relation("SupportTicketAuthor")
  supportMessages           SupportMessage[]           @relation("SupportMessageAuthor")
  /// Aeli (aeli.so) teilt sich diese Identitaet mit Aera. Ein Konto, zwei
  /// Produkte: wer hier registriert ist, kann sich auf aeli.so einloggen,
  /// ohne ein zweites Passwort zu fuehren.
  aeliProfile               AeliProfile?
  aeliPayoutAccount         AeliPayoutAccount?
}

/// Versioned evidence that a user accepted a contract document or confirmed
/// receipt of a privacy notice. Marketing consent is deliberately stored in a
/// separate model because it must remain optional and independently revocable.
model LegalAcceptance {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   String
  version    String
  source     String
  acceptedAt DateTime @default(now())

  @@unique([userId, document, version])
  @@index([document, version, acceptedAt])
}

// ----------------------------------------------------------------------------
// Tenant (a creator community)
// ----------------------------------------------------------------------------
model Tenant {
  id                     String    @id @default(cuid())
  name                   String    @unique
  slug                   String    @unique
  subdomain              String?   @unique
  customDomain           String?   @unique
  /// Gesetzt, sobald der DNS-Nachweis (CNAME/TXT) erbracht wurde. Nur
  /// verifizierte Domains werden vom Proxy aufgelöst.
  customDomainVerifiedAt DateTime?
  tagline                String?
  description            String?
  logoUrl                String?
  primaryColor           String    @default("#6d28d9")
  accentColor            String    @default("#ec4899")
  // Discover category key (see lib/categories.ts).
  category               String?

  // Community page builder config (sections order/visibility, custom nav, header
  // options). Null = platform defaults. See lib/layout.ts.
  layout Json?

  /// SEO-Overrides des Creators. Alles optional: leer bedeutet "aus den
  /// Community-Angaben ableiten" (siehe lib/seo.ts), nicht "leer ausliefern".
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  /// Eigenes Social-Bild (1200x630). Leer = Logo, sonst Plattform-Fallback.
  seoImageUrl    String?
  /// Community aus Suchmaschinen heraushalten (robots noindex + keine Sitemap).
  seoNoindex     Boolean @default(false)

  platformFeePercent Float        @default(5)
  /// Referral-Programm: Provision (in %) auf bezahlte Käufe geworbener
  /// Mitglieder. 0 = Programm ohne Geld-Provision (nur Punkte via Gamification).
  referralPercent    Float        @default(0)
  stripeAccountId    String?
  /// SUSPENDED/DELETING Tenants sind weder öffentlich noch im Creator-
  /// Dashboard erreichbar. Billing-/Cleanup-Webhooks dürfen weiterarbeiten.
  status             TenantStatus @default(ACTIVE)

  ownerId String
  owner   User   @relation("TenantOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships               Membership[]
  tiers                     MembershipTier[]
  spaces                    Space[]
  posts                     Post[]
  comments                  Comment[]
  reactions                 Reaction[]
  courses                   Course[]
  lessons                   Lesson[]
  lessonProgress            LessonProgress[]
  events                    Event[]
  eventRsvps                EventRsvp[]
  products                  Product[]
  orders                    Order[]
  subscriptions             Subscription[]
  entitlements              Entitlement[]
  campaigns                 NewsletterCampaign[]
  segments                  Segment[]
  emailEvents               EmailEvent[]
  rules                     GamificationRule[]
  pointsLedger              PointsLedger[]
  badges                    Badge[]
  badgeAwards               BadgeAward[]
  levels                    Level[]
  memberStats               MemberStats[]
  storageObjects            StorageObject[]
  storageUploadReservations StorageUploadReservation[]
  mediaFolders              MediaFolder[]
  aiChunks                  AiContextChunk[]
  recommendations           Recommendation[]
  liveSessions              LiveSession[]
  liveMessages              LiveChatMessage[]
  articles                  KnowledgeArticle[]
  auditLogs                 AuditLog[]
  chatMessages              ChatMessage[]
  conversations             Conversation[]
  conversationMembers       ConversationMember[]
  assistantConversations    AssistantConversation[]
  memberRequests            MemberRequest[]
  requestVotes              RequestVote[]
  contentPlans              ContentPlan[]
  contentPlanMedia          ContentPlanMedia[]
  bookingSlots              BookingSlot[]
  bookingReservations       BookingReservation[]
  stories                   Story[]
  tips                      Tip[]
  aiCreditWallet            AiCreditWallet?
  aiUsageEvents             AiUsageEvent[]
  aiCreditPurchases         AiCreditPurchase[]
  aiCreditReservations      AiCreditReservation[]
  notifications             Notification[]
  apiKeys                   ApiKey[]
  webhookEndpoints          WebhookEndpoint[]
  webhookDeliveries         WebhookDelivery[]
  referralConversions       ReferralConversion[]
  moderationFlags           ModerationFlag[]
  automationSteps           AutomationStep[]
  automationDeliveries      AutomationDelivery[]
  newsletterDeliveries      NewsletterDelivery[]
  newsletterConsents        NewsletterConsent[]
  newsletterConsentEvents   NewsletterConsentEvent[]
  emailSuppressions         EmailSuppression[]
  pendingCreatorCheckouts   PendingCreatorCheckout[]
  pollVotes                 PollVote[]
  promoRedemptions          PromoCodeRedemption[]
  pages                     CommunityPage[]
  /// Aeli-Profile, die auf diese Community zeigen (Bruecken-Bloecke).
  aeliProfiles              AeliProfile[]              @relation("AeliLinkedTenant")

  @@index([slug])
  @@index([category])
  @@index([status])
}

// ----------------------------------------------------------------------------
// Membership: user-in-tenant relationship
// ----------------------------------------------------------------------------
model Membership {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role            @default(MEMBER)
  status       MemberStatus    @default(ACTIVE)
  tierId       String?
  tier         MembershipTier? @relation(fields: [tierId], references: [id])
  bio          String?
  /// Persönlicher Einladungs-Code (Referral-Programm), lazily erzeugt.
  referralCode String?
  /// userId des werbenden Mitglieds (innerhalb desselben Tenants).
  referredById String?
  joinedAt     DateTime        @default(now())

  @@unique([tenantId, userId])
  @@unique([tenantId, referralCode])
  @@index([tenantId])
  @@index([tenantId, role])
  @@index([userId, status, role])
  @@index([tenantId, referredById])
  @@index([userId])
}

model MembershipTier {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  description     String?
  // Card cover image on the join page.
  coverUrl        String?
  // "Vom Creator empfohlen" highlight on the join page (max. one per tenant).
  isRecommended   Boolean         @default(false)
  priceCents      Int             @default(0)
  currency        String          @default("eur")
  interval        BillingInterval @default(FREE)
  stripeProductId String?
  stripePriceId   String?
  /// Explizites Apple-IAP-Produkt (StoreKit) für diese Stufe; null = Preis-Pool-Fallback.
  appleProductId  String?
  entitlementKey  String // e.g. "tier:premium" — granted to members on this tier
  isDefault       Boolean         @default(false)
  isPublic        Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())

  memberships   Membership[]
  subscriptions Subscription[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// Spaces & content
// ----------------------------------------------------------------------------
model Space {
  id                     String     @id @default(cuid())
  tenantId               String
  tenant                 Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                   String
  slug                   String
  type                   SpaceType
  description            String?
  icon                   String?
  visibility             Visibility @default(MEMBERS)
  // Paywall: optional minimum tier required (by entitlement key)
  requiredEntitlementKey String?
  sortOrder              Int        @default(0)
  isArchived             Boolean    @default(false)
  // Per-space display settings (sorting, pagination, layout, …) as JSON.
  settings               Json?
  createdAt              DateTime   @default(now())

  posts          Post[]
  courses        Course[]
  events         Event[]
  products       Product[]
  articles       KnowledgeArticle[]
  liveSessions   LiveSession[]
  mediaPackages  MediaPackage[]
  chatMessages   ChatMessage[]
  memberRequests MemberRequest[]
  bookingSlots   BookingSlot[]
  stories        Story[]
  tips           Tip[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

enum CommunityPageStatus {
  DRAFT
  PUBLISHED
}

/// Frei gebaute Seite einer Community — "Ueber uns", "FAQ", "Presse".
///
/// Bewusst eine eigene Tabelle statt eines weiteren Felds in `Tenant.layout`:
/// die Vorschau des Layout-Editors reicht ihren Stand als Cookie an den Server
/// weiter, und Cookies sind auf rund 4 KB begrenzt. Ein einziger Textbaustein
/// sprengt das. Ausserdem sind Seiten Inhalt und keine Layout-Einstellung —
/// sie haben eine eigene Adresse, eigene Sichtbarkeit und einen Entwurfsstand.
model CommunityPage {
  id                     String              @id @default(cuid())
  tenantId               String
  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Letzter Teil der Adresse: /c/{community}/p/{slug}
  slug                   String
  title                  String
  /// Kurzbeschreibung fuer Suchmaschinen und Linkvorschauen.
  description            String?
  status                 CommunityPageStatus @default(DRAFT)
  visibility             Visibility          @default(PUBLIC)
  /// Optionaler Schluessel, wenn die Seite an eine bestimmte Stufe haengt.
  requiredEntitlementKey String?
  /// Im Reitermenue unter dem Kopfbereich zeigen. Aus = Seite bleibt
  /// erreichbar, taucht aber nur ueber einen selbst gesetzten Link auf.
  showInNav              Boolean             @default(true)
  sortOrder              Int                 @default(0)
  /// Inhaltsbausteine in Reihenfolge. Aufbau: lib/community-pages.ts
  blocks                 Json
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status, sortOrder])
}

enum RequestStatus {
  OPEN
  ACCEPTED
  PRICED
  FULFILLED
  DECLINED
}

// REQUESTS space: members submit wishes / custom requests; the creator can
// accept, decline, or price them. Priced requests are paid via Stripe.
model MemberRequest {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId        String
  space          Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  requesterId    String
  requester      User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  title          String
  body           String        @default("")
  status         RequestStatus @default(OPEN)
  priceCents     Int           @default(0)
  currency       String        @default("eur")
  entitlementKey String? // "request:{id}" — granted on payment
  staffNote      String?
  /// Denormalized up/down vote sum, kept in sync by voteRequestAction. Orders
  /// the public wishes board (most-voted first).
  score          Int           @default(0)
  votes          RequestVote[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId, spaceId])
  @@index([tenantId, requesterId])
  @@index([tenantId, spaceId, score])
}

/// Reddit-style up/down vote on a member wish. value is +1 (up) or -1 (down).
model RequestVote {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestId String
  request   MemberRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime      @default(now())

  @@unique([requestId, userId])
  @@index([tenantId, requestId])
}

enum ContentPlanType {
  POST
  VIDEO
  STREAM
  STORY
  NEWSLETTER
  EVENT
  PRODUCT_DROP
  OTHER
}

enum ContentPlanStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Standalone content planner: a creator schedules posts, videos, streams, etc.
/// Independent from Post.scheduledAt / Story.publishAt (linking comes later).
model ContentPlan {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        ContentPlanType    @default(POST)
  status      ContentPlanStatus  @default(DRAFT)
  scheduledAt DateTime?
  completedAt DateTime?
  /// Optional target space (soft reference, validated on write).
  spaceId     String?
  /// Checklist as JSON: [{ id, text, done }].
  checklist   Json?
  /// Last AI suggestion shown as an info box.
  aiNotes     String?
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  media       ContentPlanMedia[]

  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, scheduledAt])
}

/// A media attachment on a content plan. Stores a URL snapshot so the plan
/// survives deletion of the underlying StorageObject.
model ContentPlanMedia {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId          String
  plan            ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  storageObjectId String?
  url             String
  contentType     String?
  caption         String?
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())

  @@index([tenantId, planId])
  @@index([planId])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// BOOKING space: bookable 1:1 slots and their reservations.
model BookingSlot {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  hostId      String
  title       String
  startsAt    DateTime
  durationMin Int      @default(30)
  priceCents  Int      @default(0)
  currency    String   @default("eur")
  capacity    Int      @default(1)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  reservations BookingReservation[]

  @@index([tenantId, spaceId])
  @@index([tenantId, startsAt])
}

model BookingReservation {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slotId          String
  slot            BookingSlot       @relation(fields: [slotId], references: [id], onDelete: Cascade)
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          ReservationStatus @default(PENDING)
  stripeSessionId String?           @unique
  createdAt       DateTime          @default(now())

  @@index([tenantId, slotId])
  @@index([tenantId, userId])
}

// STORIES space: ephemeral posts that expire (typically after 24h).
model Story {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId   String
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  imageUrl  String?
  videoUrl  String?
  caption   String?
  /// Go-live time. `publishAt > now` = scheduled; `publishAt <= now < expiresAt`
  /// = active; `expiresAt <= now` = archived. State is purely time-derived.
  publishAt DateTime  @default(now())
  /// Ablauf. `null` heisst: laeuft nie ab und bleibt dauerhaft sichtbar —
  /// das Fehlen eines Ablaufs ist ehrlicher als ein Datum im Jahr 3000.
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, spaceId])
  @@index([tenantId, expiresAt])
  @@index([tenantId, publishAt])
}

enum TipStatus {
  PENDING
  PAID
  REFUNDED
}

// TIPS space: tips / shoutouts, optionally toward a goal.
model Tip {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId     String
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    String    @default("eur")
  message     String?
  isPublic    Boolean   @default(true)
  status      TipStatus @default(PENDING)
  createdAt   DateTime  @default(now())

  @@index([tenantId, spaceId])
}

// Gallery: a folder/album of media (images + videos), free or for sale.
model MediaPackage {
  id             String    @id @default(cuid())
  tenantId       String
  spaceId        String
  space          Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  description    String?
  coverUrl       String?
  priceCents     Int       @default(0) // 0 = free to view
  currency       String    @default("eur")
  entitlementKey String // "media:{slug}" — granted on purchase
  isPublished    Boolean   @default(true)
  // Optional campaign end: after this the package is hidden from the community.
  availableUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items MediaItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, spaceId])
}

model MediaItem {
  id             String       @id @default(cuid())
  tenantId       String
  packageId      String
  package        MediaPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  type           String // IMAGE | VIDEO
  url            String
  caption        String?
  sortOrder      Int          @default(0)
  // Per-item pay-per-view inside a package. 0 = inherits package access.
  priceCents     Int          @default(0)
  entitlementKey String? // "media-item:{id}" — granted on single-item purchase
  teaserUrl      String? // blurred/low-res preview shown to non-buyers
  isPreview      Boolean      @default(false) // free sample even in a paid package
  createdAt      DateTime     @default(now())

  @@index([tenantId, packageId])
}

model Post {
  id                String     @id @default(cuid())
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId           String
  space             Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId          String
  author            User       @relation(fields: [authorId], references: [id])
  title             String?
  body              String     @default("") // plain text (search / excerpts)
  bodyHtml          String? // rich HTML for blog posts (WYSIWYG)
  imageUrl          String? // gallery image / post attachment
  /// Alle Bilder eines Beitrags in Anzeigereihenfolge. `imageUrl` bleibt mit
  /// dem ersten Eintrag gleichgeschaltet, damit Kacheln, Suche, mobile API
  /// und Vorschaubilder unveraendert weiterlaufen — dort zaehlt genau ein
  /// Bild, und das ist immer das erste.
  imageUrls         String[]   @default([])
  videoUrl          String? // video post
  isPinned          Boolean    @default(false)
  isPublished       Boolean    @default(true)
  publishedAt       DateTime   @default(now())
  // Scheduled go-live: when set and in the future the post stays hidden until a
  // cron flips isPublished. Public queries additionally require publishedAt <= now.
  scheduledAt       DateTime?
  /// Wer den Beitrag lesen darf. PUBLIC = jeder, der den Space sieht;
  /// MEMBERS = aktive Mitgliedschaft noetig; PAID = bezahlter Zugang noetig.
  /// Unabhaengig von priceCents: ein Beitrag kann "nur fuer Mitglieder" sein,
  /// ohne einzeln verkauft zu werden.
  visibility        Visibility @default(PUBLIC)
  // Pay-per-view / pay-per-post: 0 = free. When > 0 the body/media are gated
  // behind `entitlementKey` (video:{id} for VIDEOS spaces, post:{id} otherwise).
  priceCents        Int        @default(0)
  currency          String     @default("eur")
  entitlementKey    String? // set on create when priceCents > 0
  teaserUrl         String? // public teaser image/poster shown to non-buyers
  // Poll attached to this post: pollQuestion set => the post has a poll,
  // pollOptions holds the option labels, votes live in PollVote.
  pollQuestion      String?
  pollOptions       String[]   @default([])
  pollMultiple      Boolean    @default(false)
  // Per-post settings authored in the composer's "Settings" panel.
  customSlug        String?
  customHtml        String?
  hideComments      Boolean    @default(false)
  closeComments     Boolean    @default(false)
  hideLikes         Boolean    @default(false)
  hideMetaInfo      Boolean    @default(false)
  hideFromFeatured  Boolean    @default(false)
  disableTruncation Boolean    @default(false)
  // Cover image (banner) with a stored focal point + zoom for object-cover.
  coverUrl          String?
  coverOffsetX      Int        @default(50)
  coverOffsetY      Int        @default(50)
  coverZoom         Int        @default(100)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  comments  Comment[]
  reactions Reaction[]
  pollVotes PollVote[]

  @@unique([tenantId, customSlug])
  @@index([tenantId, spaceId])
  @@index([tenantId, createdAt])
  @@index([tenantId, authorId])
}

model Comment {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  body      String
  parentId  String?
  parent    Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentThread")
  createdAt DateTime  @default(now())

  reactions Reaction[]

  @@index([tenantId, postId])
  @@index([tenantId, authorId])
  @@index([parentId])
}

model Reaction {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  type      String   @default("LIKE")
  createdAt DateTime @default(now())

  @@unique([userId, postId, type])
  @@unique([userId, commentId, type])
  @@index([postId, type])
  @@index([commentId, type])
  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// Courses & lessons
// ----------------------------------------------------------------------------
model Course {
  id                     String  @id @default(cuid())
  tenantId               String
  tenant                 Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId                String
  space                  Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  title                  String
  slug                   String
  description            String?
  coverUrl               String?
  isPublished            Boolean @default(false)
  requiredEntitlementKey String?

  // Delivery format: "ONLINE" (video / live stream) or "OFFLINE" (in person).
  format    String    @default("ONLINE")
  videoUrl  String? // online: recorded video URL
  streamUrl String? // online: live stream / meeting URL
  location  String? // offline: venue name
  address   String? // offline: full address
  startsAt  DateTime? // offline: date & time
  capacity  Int? // offline: number of seats

  createdAt DateTime @default(now())

  lessons Lesson[]

  @@unique([tenantId, slug])
  @@index([tenantId, spaceId])
}

model Lesson {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  slug          String
  content       String   @default("")
  videoUrl      String?
  durationSec   Int      @default(0)
  sortOrder     Int      @default(0)
  isPreview     Boolean  @default(false)
  /// Drip-Content: erst N Tage nach Community-Beitritt freigeschaltet.
  /// Null/0 = sofort verfügbar.
  dripAfterDays Int?
  createdAt     DateTime @default(now())

  progress LessonProgress[]

  @@unique([courseId, slug])
  @@index([tenantId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([lessonId, userId])
  @@index([tenantId, userId])
}

// ----------------------------------------------------------------------------
// Events
// ----------------------------------------------------------------------------
model Event {
  id                     String    @id @default(cuid())
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId                String
  space                  Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  title                  String
  slug                   String
  description            String?
  coverUrl               String?
  startsAt               DateTime
  endsAt                 DateTime?
  location               String?
  isOnline               Boolean   @default(true)
  meetingUrl             String?
  capacity               Int?
  requiredEntitlementKey String?
  createdAt              DateTime  @default(now())

  rsvps EventRsvp[]

  @@unique([tenantId, slug])
  @@index([tenantId, startsAt])
}

model EventRsvp {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    RsvpStatus @default(GOING)
  createdAt DateTime   @default(now())

  @@unique([eventId, userId])
  @@index([tenantId, eventId])
}

// ----------------------------------------------------------------------------
// Commerce
// ----------------------------------------------------------------------------
model Product {
  id                   String      @id @default(cuid())
  tenantId             String
  tenant               Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId              String?
  space                Space?      @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  name                 String
  slug                 String
  description          String?
  // Primary cover image (kept in sync with images[0] for list/tile displays).
  coverUrl             String?
  // Full image gallery (cover first). Empty = no images.
  images               String[]    @default([])
  priceCents           Int         @default(0)
  currency             String      @default("eur")
  type                 ProductType @default(DIGITAL)
  stripeProductId      String?
  stripePriceId        String?
  /// Explizites Apple-IAP-Produkt (StoreKit); PHYSICAL-Produkte sind nie per IAP kaufbar.
  appleProductId       String?
  downloadUrl          String?
  grantsEntitlementKey String? // entitlement granted on purchase
  isPublished          Boolean     @default(true)

  // Physical products: shipping & inventory
  requiresShipping Boolean @default(false)
  freeShipping     Boolean @default(false)
  shippingCents    Int     @default(0)
  stock            Int? // null = unbegrenzt

  createdAt DateTime @default(now())

  orders Order[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Order {
  id                              String      @id @default(cuid())
  tenantId                        String
  tenant                          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                          String
  user                            User        @relation(fields: [userId], references: [id])
  productId                       String?
  product                         Product?    @relation(fields: [productId], references: [id])
  description                     String
  amountCents                     Int
  currency                        String      @default("eur")
  platformFeeCents                Int         @default(0)
  shippingCents                   Int         @default(0)
  status                          OrderStatus @default(PENDING)
  // Shipping address captured at checkout (for physical products).
  shippingDetails                 Json?
  fulfilled                       Boolean     @default(false)
  stripeSessionId                 String?     @unique
  stripePaymentIntentId           String?
  // Limited physical inventory is reserved before an external checkout is
  // created. These timestamps make release/fulfilment idempotent across
  // duplicate submits, Stripe retries and expired Checkout Sessions.
  inventoryReservedAt             DateTime?
  inventoryReservationExpiresAt   DateTime?
  inventoryReleasedAt             DateTime?
  /// Apple-IAP: transactionId der signierten StoreKit-Transaktion (Idempotenz).
  appleTransactionId              String?     @unique
  // Snapshot used to revoke paid access even if the product/package changes.
  grantedEntitlementKey           String?
  /// Evidence for immediate delivery of paid digital content. Null for
  /// physical goods and legacy orders created before consent capture.
  immediatePerformanceConsentedAt DateTime?
  withdrawalLossAcknowledgedAt    DateTime?
  legalTermsVersion               String?
  refundedAt                      DateTime?
  createdAt                       DateTime    @default(now())

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, stripePaymentIntentId])
  @@index([tenantId, productId, userId, status])
  @@index([status, inventoryReservationExpiresAt])
}

model Subscription {
  id                              String             @id @default(cuid())
  tenantId                        String
  tenant                          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                          String
  user                            User               @relation(fields: [userId], references: [id])
  tierId                          String
  tier                            MembershipTier     @relation(fields: [tierId], references: [id])
  status                          SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId            String?            @unique
  /// Apple-IAP: originalTransactionId des Auto-Renewable-Abos (Idempotenz + Notification-Sync).
  appleOriginalTransactionId      String?            @unique
  currentPeriodEnd                DateTime?
  cancelAtPeriodEnd               Boolean            @default(false)
  /// Evidence for immediate access during the consumer withdrawal period.
  immediatePerformanceConsentedAt DateTime?
  withdrawalLossAcknowledgedAt    DateTime?
  legalTermsVersion               String?
  createdAt                       DateTime           @default(now())
  /// Für Analytics (z. B. Kündigungen der letzten 30 Tage).
  updatedAt                       DateTime           @default(now()) @updatedAt

  @@index([tenantId, userId])
}

model Entitlement {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String // e.g. "tier:premium", "product:masterclass"
  source    EntitlementSource @default(MANUAL)
  sourceId  String?
  grantedAt DateTime          @default(now())
  expiresAt DateTime?

  @@unique([tenantId, userId, key])
  @@index([tenantId, key])
  @@index([tenantId, userId])
}

// ----------------------------------------------------------------------------
// Newsletter
// ----------------------------------------------------------------------------
model NewsletterCampaign {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject        String
  body           String // Text (Absätze) oder kompletter HTML-Code, je nach bodyFormat
  bodyFormat     CampaignBodyFormat @default(TEXT)
  status         CampaignStatus     @default(DRAFT)
  segmentId      String?
  segment        Segment?           @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int                @default(0)
  createdById    String
  createdBy      User               @relation(fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())

  emailEvents EmailEvent[]
  deliveries  NewsletterDelivery[]

  @@index([tenantId, status])
}

model Segment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // JSON rules e.g. { "tierSlug": "premium", "minPoints": 100, "activeSinceDays": 30 }
  rules       Json     @default("{}")
  createdAt   DateTime @default(now())

  campaigns NewsletterCampaign[]

  @@index([tenantId])
}

model EmailEvent {
  id         String              @id @default(cuid())
  tenantId   String
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   NewsletterCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String
  type       EmailEventType      @default(QUEUED)
  /// Stable key for retry-safe terminal delivery events.
  dedupeKey  String?             @unique
  createdAt  DateTime            @default(now())

  @@index([tenantId, campaignId])
}

model NewsletterDelivery {
  id                String                   @id @default(cuid())
  tenantId          String
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaignId        String
  campaign          NewsletterCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId            String
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientEmail    String
  subject           String
  html              String
  status            NewsletterDeliveryStatus @default(PENDING)
  attempts          Int                      @default(0)
  nextAttemptAt     DateTime                 @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  leaseUntil        DateTime?
  providerMessageId String?
  /// Public bearer URL used only for the safe unsubscribe operation. It is
  /// embedded into the immutable email snapshot and the RFC 8058 headers.
  unsubscribeUrl    String?
  error             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([campaignId, userId])
  @@index([tenantId, campaignId])
  @@index([status, nextAttemptAt])
}

/// Current per-community newsletter preference. Rows are created only after
/// an explicit opt-in or withdrawal; the migration deliberately creates no
/// rows for existing members.
model NewsletterConsent {
  id              String                  @id @default(cuid())
  tenantId        String
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email           String
  status          NewsletterConsentStatus
  optedInAt       DateTime?
  optedInSource   String?
  withdrawnAt     DateTime?
  withdrawnSource String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  events NewsletterConsentEvent[]

  @@unique([tenantId, userId])
  @@index([tenantId, status, updatedAt])
  @@index([userId])
}

/// Append-only evidence trail for opt-ins and withdrawals. Source values are
/// stable technical identifiers, never free-form legal conclusions.
model NewsletterConsentEvent {
  id        String                     @id @default(cuid())
  tenantId  String
  tenant    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consentId String
  consent   NewsletterConsent          @relation(fields: [consentId], references: [id], onDelete: Cascade)
  userId    String
  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  type      NewsletterConsentEventType
  source    String
  createdAt DateTime                   @default(now())

  @@index([tenantId, userId, createdAt])
  @@index([consentId, createdAt])
}

/// Active suppressions are never bypassed by segment rules. A new explicit
/// opt-in may lift UNSUBSCRIBED, but bounce/complaint suppressions require a
/// separate operational review.
model EmailSuppression {
  id           String                 @id @default(cuid())
  tenantId     String
  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String
  reason       EmailSuppressionReason
  source       String
  suppressedAt DateTime               @default(now())
  liftedAt     DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([tenantId, email, reason])
  @@index([tenantId, email, liftedAt])
  @@index([userId])
}

/// Global, privileged inbox used to deduplicate signed Resend webhook events.
/// It contains only delivery metadata required for reliable processing.
model EmailWebhookEvent {
  id                String    @id
  type              String
  providerMessageId String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([providerMessageId])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// Global background-job heartbeat (privileged worker only)
// ----------------------------------------------------------------------------
model CronJobHeartbeat {
  /// Stable route/job name, e.g. "newsletters" or "inventory".
  job             String        @id
  status          CronJobStatus @default(IDLE)
  lastStartedAt   DateTime?
  lastSucceededAt DateTime?
  lastFailedAt    DateTime?
  lastDurationMs  Int?
  /// Numeric, job-specific counters from the most recent completed run.
  lastCounters    Json          @default("{}")
  /// Sanitized message only; stack traces, URLs and credentials are excluded.
  lastError       String?
  totalRuns       Int           @default(0)
  totalSucceeded  Int           @default(0)
  totalFailed     Int           @default(0)
  /// Compare-and-set token and lease prevent overlapping executions per job.
  runToken        String?
  leaseUntil      DateTime?
  updatedAt       DateTime      @updatedAt

  @@index([status, updatedAt])
}

// Durable platform lifecycle jobs intentionally have no Tenant/User foreign
// keys: they must survive deletion of their target and remain retryable.
model DataDeletionJob {
  id                 String             @id @default(cuid())
  scope              DataDeletionScope
  targetId           String
  requestedById      String?
  targetLabel        String?
  status             DataDeletionStatus @default(PENDING)
  phase              String             @default("BILLING")
  attempts           Int                @default(0)
  nextAttemptAt      DateTime           @default(now())
  leaseUntil         DateTime?
  lastError          String?
  counters           Json               @default("{}")
  objectScanCursor   String?
  objectScanComplete Boolean            @default(false)
  completedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  objectTasks ObjectDeletionTask[]

  @@unique([scope, targetId])
  @@index([status, nextAttemptAt])
}

model ObjectDeletionTask {
  id            String               @id @default(cuid())
  jobId         String?
  job           DataDeletionJob?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  tenantId      String?
  key           String               @unique
  reason        String
  status        ObjectDeletionStatus @default(PENDING)
  attempts      Int                  @default(0)
  nextAttemptAt DateTime             @default(now())
  leaseUntil    DateTime?
  lastError     String?
  completedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([jobId, status])
  @@index([status, nextAttemptAt])
  @@index([tenantId, status])
}

model StorageReconciliationState {
  tenantId          String    @id
  continuationToken String?
  scanStartedAt     DateTime?
  lastCompletedAt   DateTime?
  lastScanned       Int       @default(0)
  lastOrphans       Int       @default(0)
  updatedAt         DateTime  @updatedAt
}

/// Legally required financial snapshots survive tenant/user erasure without
/// retaining live account relations. Subject identifiers are one-way hashes.
model BillingRetentionRecord {
  id              String   @id @default(cuid())
  source          String
  sourceId        String
  tenantScopeHash String
  subjectHash     String?
  payload         Json
  retainUntil     DateTime
  createdAt       DateTime @default(now())

  @@unique([source, sourceId])
  @@index([tenantScopeHash, retainUntil])
  @@index([retainUntil])
}

// ----------------------------------------------------------------------------
// Gamification
// ----------------------------------------------------------------------------
model GamificationRule {
  id        String              @id @default(cuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  trigger   GamificationTrigger
  points    Int                 @default(10)
  isActive  Boolean             @default(true)
  maxPerDay Int?
  createdAt DateTime            @default(now())

  ledger PointsLedger[]

  @@index([tenantId, trigger])
}

model PointsLedger {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int
  reason    String
  ruleId    String?
  rule      GamificationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  refType   String?
  refId     String?
  // Stable idempotency key for retryable actions such as Stripe fulfillment.
  dedupeKey String?           @unique
  createdAt DateTime          @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@index([tenantId, userId, ruleId, createdAt])
}

model Badge {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  iconUrl     String?
  // JSON criteria e.g. { "type": "points", "threshold": 100 } | { "type": "posts", "threshold": 10 }
  criteria    Json     @default("{}")
  createdAt   DateTime @default(now())

  awards BadgeAward[]

  @@index([tenantId])
}

model BadgeAward {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([badgeId, userId])
  @@index([tenantId, userId])
}

model Level {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  minPoints Int    @default(0)
  sortOrder Int    @default(0)

  @@index([tenantId, minPoints])
}

model MemberStats {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  points       Int       @default(0)
  levelName    String?
  streakDays   Int       @default(0)
  lastActiveOn DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId, points])
}

// ----------------------------------------------------------------------------
// Storage / media
// ----------------------------------------------------------------------------
model MediaFolder {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  /// Folder accent color as a hex string (e.g. "#C2410C").
  color     String          @default("#C2410C")
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  objects   StorageObject[]

  @@index([tenantId])
}

model StorageObject {
  id                     String            @id @default(cuid())
  tenantId               String
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId                String?
  owner                  User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  key                    String
  url                    String
  purpose                String            @default("upload")
  contentType            String?
  sizeBytes              Int               @default(0)
  visibility             StorageVisibility @default(MEMBERS)
  requiredEntitlementKey String?
  /// Optional library display name (S3 key stays unchanged).
  displayName            String?
  /// Optional folder in the creator media library.
  folderId               String?
  folder                 MediaFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt              DateTime          @default(now())

  @@index([tenantId])
  @@index([folderId])
}

/// Short-lived, quota-counted authorization for a direct browser-to-S3 PUT.
/// The corresponding StorageObject becomes visible only after size, checksum,
/// magic bytes and malware policy have been verified server-side.
model StorageUploadReservation {
  id             String              @id @default(cuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  key            String              @unique
  purpose        String
  contentType    String
  sizeBytes      Int
  checksumSha256 String
  visibility     StorageVisibility
  status         StorageUploadStatus @default(RESERVED)
  expiresAt      DateTime
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([tenantId, status, expiresAt])
  @@index([ownerId, createdAt])
}

// ----------------------------------------------------------------------------
// AI context & recommendations (tenant-isolated)
// ----------------------------------------------------------------------------
model AiContextChunk {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceType String // POST | PRODUCT | LESSON | EVENT | ARTICLE
  sourceId   String
  title      String?
  content    String
  keywords   String   @default("") // space-separated, for offline keyword recall
  embedding  Json? // float[] when OpenAI key configured, else null
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId, sourceType])
}

model Recommendation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refType   String // PRODUCT | POST | LESSON | EVENT
  refId     String
  score     Float    @default(0)
  reason    String?
  createdAt DateTime @default(now())

  @@index([tenantId, userId])
}

// ----------------------------------------------------------------------------
// Live streaming
// ----------------------------------------------------------------------------
model LiveSession {
  id                     String     @id @default(cuid())
  tenantId               String
  tenant                 Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId                String?
  space                  Space?     @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  title                  String
  status                 LiveStatus @default(SCHEDULED)
  source                 LiveSource @default(EXTERNAL)
  ingest                 LiveIngest @default(BROWSER)
  roomName               String     @unique
  hostId                 String
  /// UID des Cloudflare-Live-Inputs. Der Sendeschlüssel wird bewusst nicht
  /// gespeichert, sondern bei Bedarf von Cloudflare geholt.
  cfInputId              String?    @unique
  /// Video-ID der Cloudflare-Aufzeichnung. Getrennt von `replayUrl`, weil eine
  /// geschützte Aufzeichnung erst beim Abspielen eine signierte Adresse bekommt.
  cfReplayId             String?
  streamUrl              String?
  replayUrl              String?
  requiredEntitlementKey String?
  startsAt               DateTime?
  endedAt                DateTime?
  createdAt              DateTime   @default(now())

  messages LiveChatMessage[]

  @@index([tenantId, status])
}

model LiveChatMessage {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime    @default(now())

  @@index([tenantId, sessionId])
}

// ----------------------------------------------------------------------------
// Knowledge base
// ----------------------------------------------------------------------------
model KnowledgeArticle {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  body        String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, spaceId])
}

// ----------------------------------------------------------------------------
// Audit log
// ----------------------------------------------------------------------------
model AuditLog {
  id              String    @id @default(cuid())
  tenantId        String?
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUserId     String?
  action          String
  targetType      String?
  targetId        String?
  metadata        Json      @default("{}")
  /// Audit evidence is detached from deleted tenants but retained for the
  /// documented legal/security window under a pseudonymous scope hash.
  tenantScopeHash String?
  retentionUntil  DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantScopeHash, retentionUntil])
}

// ----------------------------------------------------------------------------
// Chat & Direct Messages
// ----------------------------------------------------------------------------

// A 1:1 direct-message thread between two community members. Group chats reuse
// the Space model (type = CHAT), so a ChatMessage belongs to exactly one of
// `spaceId` (group) or `conversationId` (direct).
model Conversation {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // "DIRECT" (1:1 DM) or "GROUP" (creator-run room). Plain string, not a Prisma
  // enum, so it can evolve without a client regeneration.
  kind          String   @default("DIRECT")
  // Group chats only: display name, avatar tint and access gate.
  title         String?
  avatarColor   String?
  // null = all members · "__paid__" = paying members · "tier:<slug>" = a level.
  accessKey     String?
  createdById   String?
  createdAt     DateTime @default(now())
  // Denormalised for cheap "sort by most recent activity" in the inbox.
  lastMessageAt DateTime @default(now())

  members  ConversationMember[]
  messages ChatMessage[]

  @@index([tenantId, kind, lastMessageAt])
}

model ConversationMember {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Read receipts / unread badges.
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([tenantId, userId])
}

model ChatMessage {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Group chat target (Space of type CHAT) …
  spaceId        String?
  space          Space?        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  // … or direct-message thread. Exactly one is set.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime      @default(now())

  @@index([tenantId, spaceId, createdAt])
  @@index([tenantId, conversationId, createdAt])
}

// ----------------------------------------------------------------------------
// AI Assistant (dashboard) — persisted conversations with tool use.
// ----------------------------------------------------------------------------
model AssistantConversation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "CHAT" (text assistant) or "IMAGE" (image generation). Kept as a plain
  // string so it can evolve without a client regeneration.
  kind      String   @default("CHAT")
  title     String   @default("Neuer Chat")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AssistantMessage[]

  @@index([tenantId, userId, kind, updatedAt])
}

model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}

// ----------------------------------------------------------------------------
// AI credits — one wallet per tenant. `includedRemaining` is the plan's monthly
// allowance (resets each period); `purchasedRemaining` are bought top-ups that
// roll over. Consumption draws from the included allowance first.
// ----------------------------------------------------------------------------
model AiCreditWallet {
  id                        String              @id @default(cuid())
  tenantId                  String              @unique
  tenant                    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                      CreatorPlan         @default(FREE)
  monthlyCredits            Int                 @default(500)
  includedRemaining         Int                 @default(500)
  purchasedRemaining        Int                 @default(0)
  periodStart               DateTime            @default(now())
  periodEnd                 DateTime
  stripeCustomerId          String?
  stripeSubscriptionId      String?             @unique
  // Business idempotency key for payment-driven monthly allowance refills.
  lastPaidStripeInvoiceId   String?             @unique
  creatorSubscriptionStatus SubscriptionStatus?
  planCancelAtPeriodEnd     Boolean             @default(false)
  planCurrentPeriodEnd      DateTime?
  /// Origin of `plan`. Promo grants are refilled locally (like FREE) and
  /// downgraded automatically once `promoExpiresAt` has passed.
  planSource                CreatorPlanSource   @default(DEFAULT)
  promoCodeId               String?
  promoCode                 PromoCode?          @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoExpiresAt            DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
}

// Durable boundary between a creator's plan choice and Stripe Checkout. The
// row exists before Stripe can accept money, so destructive tenant operations
// can see open sessions even before a subscription id exists on the wallet.
model PendingCreatorCheckout {
  id                   String                @id @default(cuid())
  tenantId             String
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 CreatorPlan
  status               CreatorCheckoutStatus @default(CREATING)
  stripeSessionId      String?               @unique
  stripeSubscriptionId String?               @unique
  expiresAt            DateTime
  completedAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([tenantId, status])
  @@index([status, expiresAt])
}

// Per-call usage ledger (metered from Gemini token counts).
model AiUsageEvent {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String?
  conversationId String?
  kind           String   @default("assistant_message")
  promptTokens   Int      @default(0)
  outputTokens   Int      @default(0)
  totalTokens    Int      @default(0)
  credits        Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ----------------------------------------------------------------------------
// Platform help center — admin-managed, tenant-neutral, public at /hilfe.
// ----------------------------------------------------------------------------
model HelpCategory {
  id          String   @id @default(cuid())
  locale      String   @default("de")
  title       String
  slug        String
  description String?
  icon        String   @default("knowledge")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  articles HelpArticle[]

  @@unique([locale, slug])
  @@index([sortOrder])
  @@index([locale, sortOrder])
}

model HelpArticle {
  id          String       @id @default(cuid())
  categoryId  String
  category    HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  sortOrder   Int          @default(0)
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId, sortOrder])
}

// Credit top-up purchases (packs).
model AiCreditPurchase {
  id                    String    @id @default(cuid())
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                String?
  packId                String?
  credits               Int
  priceCents            Int
  currency              String    @default("eur")
  status                String    @default("COMPLETED")
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  refundedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, stripePaymentIntentId])
}

// A one-credit lease acquired before an external AI request. Settlement and
// release are database-atomic so concurrent requests cannot overspend a wallet.
model AiCreditReservation {
  id              String                    @id
  tenantId        String
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String?
  conversationId  String?
  kind            String                    @default("assistant_message")
  source          AiCreditSource
  reservedCredits Int                       @default(1)
  chargedCredits  Int?
  promptTokens    Int                       @default(0)
  outputTokens    Int                       @default(0)
  totalTokens     Int                       @default(0)
  status          AiCreditReservationStatus @default(RESERVED)
  expiresAt       DateTime
  settledAt       DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([tenantId, status, expiresAt])
  @@index([tenantId, createdAt])
}

// Durable inbox for Stripe events. This is platform-operational data rather
// than tenant content, so events can still be retried after a tenant was
// removed and events without tenant metadata can be diagnosed.
model StripeWebhookEvent {
  id          String              @id
  type        String
  objectId    String?
  tenantId    String?
  status      StripeWebhookStatus @default(PROCESSING)
  attempts    Int                 @default(1)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([tenantId, createdAt])
  @@index([status, updatedAt])
}

// ----------------------------------------------------------------------------
// In-App-Benachrichtigungen (pro Tenant, pro Empfänger)
// ----------------------------------------------------------------------------
enum NotificationType {
  POST_COMMENT // jemand hat deinen Beitrag kommentiert
  COMMENT_REPLY // jemand hat auf deinen Kommentar geantwortet
  REACTION // jemand hat auf deinen Beitrag reagiert
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Empfänger der Benachrichtigung.
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  /// Auslöser (z. B. der Kommentator). Null, wenn das Konto gelöscht wurde.
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      NotificationType
  message   String
  /// Ziel-Link innerhalb der Community (z. B. der kommentierte Beitrag).
  href      String
  refType   String?
  refId     String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([tenantId, userId, readAt])
  @@index([tenantId, userId, createdAt])
}

// ----------------------------------------------------------------------------
// Öffentliche API (Keys) & ausgehende Webhooks
// ----------------------------------------------------------------------------
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  /// Anzeige-Präfix (z. B. "aera_sk_3f9a…") — der volle Key wird nie gespeichert.
  prefix     String
  /// SHA-256-Hash des vollständigen Keys.
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  /// Shared Secret für die HMAC-SHA256-Signatur (Header `Aera-Signature`).
  secret    String
  /// Abonnierte Event-Typen (z. B. "member.joined", "order.paid").
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([tenantId])
}

model WebhookDelivery {
  id            String                @id @default(cuid())
  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpointId    String
  endpoint      WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId       String
  event         String
  payload       Json
  /// HTTP-Status der Zustellung; null bei Netzwerkfehler.
  responseCode  Int?
  ok            Boolean               @default(false)
  error         String?
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now())
  lastAttemptAt DateTime?
  deliveredAt   DateTime?
  leaseUntil    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([endpointId, eventId])
  @@index([tenantId, endpointId, createdAt])
  @@index([status, nextAttemptAt])
}

// ----------------------------------------------------------------------------
// Web-Push (global pro Nutzer, nicht tenant-gebunden)
// ----------------------------------------------------------------------------
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ----------------------------------------------------------------------------
// KI-Moderation (Auto-Flagging von Beiträgen/Kommentaren)
// ----------------------------------------------------------------------------
enum ModerationStatus {
  PENDING // wartet auf Entscheidung des Teams
  APPROVED // freigegeben (Fehlalarm)
  REMOVED // Inhalt entfernt
}

model ModerationFlag {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "Post" | "Comment"
  refType      String
  refId        String
  authorId     String?
  /// z. B. "spam", "toxisch", "belaestigung"
  category     String
  /// Kurzbegründung des Klassifikators (KI oder Heuristik).
  reason       String
  /// "gemini" oder "heuristik"
  source       String           @default("heuristik")
  status       ModerationStatus @default(PENDING)
  /// Auszug des gemeldeten Inhalts (Anzeige ohne Join).
  excerpt      String
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())

  @@unique([tenantId, refType, refId])
  @@index([tenantId, status, createdAt])
}

// ----------------------------------------------------------------------------
// Onboarding-Automationen (zeitversetzte E-Mail-Serie nach Beitritt)
// ----------------------------------------------------------------------------
model AutomationStep {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Tage nach Beitritt (0 = sofort beim nächsten Lauf).
  dayOffset Int      @default(0)
  subject   String
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries AutomationDelivery[]

  @@index([tenantId, dayOffset])
}

model AutomationDelivery {
  id                String                   @id @default(cuid())
  tenantId          String
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stepId            String
  step              AutomationStep           @relation(fields: [stepId], references: [id], onDelete: Cascade)
  userId            String
  recipientEmail    String
  subject           String
  html              String
  status            AutomationDeliveryStatus @default(PENDING)
  attempts          Int                      @default(0)
  nextAttemptAt     DateTime                 @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  leaseUntil        DateTime?
  providerMessageId String?
  unsubscribeUrl    String?
  error             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User                     @relation(fields: [userId], references: [id])

  @@unique([stepId, userId])
  @@index([tenantId, userId])
  @@index([status, nextAttemptAt])
}

// ----------------------------------------------------------------------------
// Referral-Programm
// ----------------------------------------------------------------------------
model ReferralConversion {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// userId des werbenden Mitglieds.
  referrerId      String
  /// userId des geworbenen Mitglieds.
  referredId      String
  /// "join" (Beitritt) oder "purchase" (bezahlter Kauf/Abo).
  kind            String
  /// Umsatzbasis in Cent (nur bei kind = "purchase").
  amountCents     Int       @default(0)
  /// Errechnete Provision in Cent (tenant.referralPercent zum Zeitpunkt).
  commissionCents Int       @default(0)
  refType         String?
  refId           String?
  reversedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@unique([tenantId, referredId, kind, refId])
  @@index([tenantId, referrerId])
  @@index([tenantId, createdAt])
}

model PollVote {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionIndex Int
  createdAt   DateTime @default(now())

  @@unique([postId, userId, optionIndex])
  @@index([tenantId])
  @@index([postId])
}

// ----------------------------------------------------------------------------
// Promotion codes — platform-issued invite codes that put a community on a paid
// creator package without Stripe. Handed to influencers and launch partners.
//
// A code is redeemed *per community*: the same code may unlock N communities
// (`maxRedemptions`), but never the same one twice (`@@unique`). Redeeming
// never touches a Stripe-owned plan; billing always wins.
// ----------------------------------------------------------------------------
model PromoCode {
  id    String      @id @default(cuid())
  /// Normalised (uppercase, A-Z/0-9/-) — this is what the creator types in.
  code  String      @unique
  plan  CreatorPlan
  /// Internal note, e.g. the influencer's name or campaign.
  label String?
  /// Optional public-facing note shown after a successful redemption.
  note  String?

  /// Access duration in days from redemption. Null = for as long as the code
  /// stays active (lifetime grant).
  durationDays    Int?
  /// How many communities may redeem this code in total.
  maxRedemptions  Int       @default(1)
  /// Denormalised counter kept in the same transaction as the redemption row.
  redemptionCount Int       @default(0)
  /// Code can no longer be redeemed after this moment (existing grants stay).
  expiresAt       DateTime?
  isActive        Boolean   @default(true)

  createdById String?
  createdBy   User?   @relation("PromoCodeAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions PromoCodeRedemption[]
  wallets     AiCreditWallet[]

  @@index([isActive, expiresAt])
  @@index([plan])
  @@index([createdAt])
}

model PromoCodeRedemption {
  id     String    @id @default(cuid())
  codeId String
  code   PromoCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Package the community was on before — enables a clean rollback.
  planBefore CreatorPlan
  planAfter  CreatorPlan
  /// Null = lifetime grant.
  expiresAt  DateTime?
  redeemedAt DateTime    @default(now())

  @@unique([codeId, tenantId])
  @@index([tenantId])
  @@index([codeId, redeemedAt])
}

// ----------------------------------------------------------------------------
// Plattform-SEO fuer aera.so selbst. Genau eine Zeile (id = "platform"); die
// Tabelle traegt bewusst keine tenantId, damit sie ausserhalb der Tenant-RLS
// bleibt und nur ueber den privilegierten Client geschrieben wird.
// ----------------------------------------------------------------------------
model PlatformSeo {
  id            String   @id @default("platform")
  siteName      String?
  title         String?
  /// Muster fuer Unterseiten, z. B. "%s — Aera". %s wird ersetzt.
  titleTemplate String?
  description   String?
  keywords      String?
  imageUrl      String?
  twitterHandle String?
  /// Notbremse: nimmt die gesamte Plattform aus dem Index.
  noindex       Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  updatedById   String?
  updatedBy     User?    @relation("PlatformSeoEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

// ----------------------------------------------------------------------------
// Der Blog von Aera selbst — Neuigkeiten ueber die Plattform.
//
// Nicht zu verwechseln mit dem Blog-Space einer Community (Modell `Post`): der
// gehoert einem Tenant und wird von einem Creator gefuellt, dieser hier gehoert
// der Plattform und wird im Admin-Bereich geschrieben. Deshalb der Praefix
// `Platform` und, wie bei `PlatformSeo`, bewusst keine `tenantId`: die Tabelle
// bleibt ausserhalb der Tenant-RLS.
// ----------------------------------------------------------------------------
enum PlatformPostStatus {
  DRAFT
  PUBLISHED
}

model PlatformPost {
  id     String @id @default(cuid())
  /// Wie im Hilfecenter: Inhalte liegen pro Sprache vor, die Anzeige faellt
  /// auf Englisch und dann Deutsch zurueck, wenn eine Sprache leer ist.
  locale String @default("de")
  slug   String
  title  String

  /// Anrisstext fuer die Uebersicht. Leer heisst nicht "kein Text", sondern
  /// "leite ihn aus dem Beitrag ab" — ein Beitrag ohne Anriss saehe in der
  /// Uebersicht aus wie ein Fehler.
  excerpt String?
  /// Bereits bereinigtes HTML (lib/rich-text.ts). Was hier steht, wird
  /// unveraendert ausgeliefert — die Pruefung passiert beim Speichern.
  bodyHtml String

  coverUrl String?
  coverAlt String?

  /// Schluessel einer Rubrik aus lib/blog.ts. Absichtlich kein Fremdschluessel:
  /// die Rubriken sind eine redaktionelle Entscheidung, keine Nutzerdaten.
  category String?

  status PlatformPostStatus @default(DRAFT)

  /// Ab wann der Beitrag oeffentlich ist. Liegt der Zeitpunkt in der Zukunft,
  /// ist der Beitrag geplant — dafuer braucht es keinen dritten Status und
  /// keinen Cronjob, nur einen Vergleich in der Abfrage.
  publishedAt DateTime?

  /// Der Aufmacher der Uebersicht. Mehrere sind technisch moeglich; die
  /// Oberflaeche nimmt den neuesten und raeumt die anderen beim Setzen ab.
  isFeatured Boolean @default(false)

  /// Beim Speichern aus dem Text berechnet, damit die Uebersicht nicht fuer
  /// jede Karte das ganze HTML durchsuchen muss.
  readingMinutes Int @default(1)

  seoTitle       String?
  seoDescription String?
  noindex        Boolean @default(false)

  authorId String?
  author   User?   @relation("PlatformPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, slug])
  @@index([locale, status, publishedAt])
  @@index([status, publishedAt])
}

// ----------------------------------------------------------------------------
// Support: Tickets von Besuchern und Mitgliedern an das Plattform-Team.
//
// Bewusst ohne tenantId — Support laeuft gegen die Plattform, nicht gegen eine
// Community. Damit bleibt die Tabelle ausserhalb der Tenant-RLS und wird
// ausschliesslich privilegiert gelesen und geschrieben.
// ----------------------------------------------------------------------------
enum SupportTicketStatus {
  /// Wartet auf uns.
  OPEN
  /// Wir haben geantwortet, Ball liegt beim Absender.
  ANSWERED
  CLOSED
}

model SupportTicket {
  id      String              @id @default(cuid())
  /// Gesetzt, wenn beim Absenden jemand eingeloggt war. Nur dann ist der
  /// Verlauf spaeter unter /member/account einsehbar.
  userId  String?
  user    User?               @relation("SupportTicketAuthor", fields: [userId], references: [id], onDelete: SetNull)
  /// Antwortadresse. Bei Gaesten die einzige Verbindung zum Ticket.
  email   String
  name    String?
  subject String
  status  SupportTicketStatus @default(OPEN)
  /// Sprache, in der uns die Person geschrieben hat. Ohne dieses Feld liefe
  /// unsere Antwort in der Sprache des antwortenden Admins hinaus.
  locale  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Sortierschluessel der Listen — aktuellste Aktivitaet zuerst.
  lastMessageAt DateTime @default(now())

  messages SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@index([email])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// true = vom Plattform-Team. Bestimmt Darstellung UND welche Seite die
  /// Nachricht als ungelesen zaehlt.
  fromStaff Boolean       @default(false)
  authorId  String?
  author    User?         @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String

  /// Gelesen-Marken pro Seite. Ungelesen fuer uns = !fromStaff && readByStaffAt
  /// ist null; ungelesen fuer den Absender spiegelbildlich.
  readByStaffAt DateTime?
  readByUserAt  DateTime?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([fromStaff, readByStaffAt])
}

// ----------------------------------------------------------------------------
// Aeli — Link-in-Bio auf aeli.so
//
// Aeli ist eine eigenstaendige Next.js-App (Ordner `aeli.so/`), die auf
// derselben Datenbank arbeitet. Die Migrationen leben ausschliesslich hier:
// `aeli.so/prisma/schema.prisma` ist ein bewusst reduziertes Spiegelschema,
// das nur den Client generiert und niemals migriert.
//
// Anders als alles darueber ist Aeli NICHT tenant-scoped. Die Isolation laeuft
// ueber `userId` (Besitzer) bzw. `status = PUBLISHED` (Oeffentlichkeit); in der
// Datenbank durchgesetzt von der Rolle `aeli_app` und dem GUC `aeli.user_id`
// (siehe Migration 20260807120000_aeli_link_in_bio).
// ----------------------------------------------------------------------------

enum AeliStatus {
  DRAFT
  PUBLISHED
}

/// Bausteine einer Aeli-Seite. Die Reihenfolge hier ist ohne Bedeutung; die
/// Darstellung entscheidet `aeli.so/lib/blocks.ts`.
enum AeliBlockType {
  /// Ein Ziel, ein Titel — die Grundform.
  LINK
  /// Zwischenueberschrift, gliedert lange Seiten.
  HEADER
  /// Freier Text (Absatz), z. B. eine kurze Ansage.
  TEXT
  /// Zeile aus Social-Icons, ohne eigene Karten.
  SOCIAL_ROW
  DIVIDER
  /// YouTube/Spotify/Vimeo & Co. — Allowlist in lib/embed.ts.
  EMBED
  /// Bild in voller Breite, optional verlinkt.
  IMAGE
  /// Bruecke in eine Aera-Community (linkedTenantId).
  COMMUNITY_CTA
  /// E-Mail-Sammlung -> AeliLead.
  NEWSLETTER
  /// Trinkgeld / Unterstuetzung.
  TIP
  PRODUCT
  BOOKING
  /// Zeigt sich nur, solange die verknuepfte Community live ist.
  LIVE_NOW
  MUSIC
  /// Kontaktformular -> AeliLead.
  CONTACT
  /// QR-Code der eigenen Seite zum Abfotografieren.
  QR_SHARE

  // --- Bausteine, die Inhalte der verknuepften Community ziehen -------------
  // Sie tragen keinen eigenen Inhalt: der Creator waehlt den Typ, den Rest
  // liest Aeli bei jedem Aufruf frisch aus Aera. Was sie sehen duerfen, steht
  // nicht in der Abfrage, sondern in den RLS-Policies der Migration
  // 20260808120000_aeli_aera_blocks — oeffentlich heisst dort oeffentlich.
  /// Kommende Termine aus oeffentlichen Event-Spaces.
  AERA_EVENTS
  /// Oeffentliche Mitgliedsstufen mit Preis, verlinkt auf die Beitrittsseite.
  AERA_TIERS
  /// Veroeffentlichte Produkte aus oeffentlichen Shop-Spaces.
  AERA_SHOP
  /// Veroeffentlichte Kurse aus oeffentlichen Kurs-Spaces.
  AERA_COURSES
  /// Die oeffentlichen Raeume der Community als Wegweiser.
  AERA_SPACES
}

/// Ein einziges append-only Ereignis-Log traegt Seitenaufrufe UND Klicks.
/// Getrennte Tabellen waeren zwei Schreibpfade, zwei Indizes und zwei
/// Aggregationen fuer dieselbe Frage ("wie viele davon haben geklickt?").
enum AeliEventKind {
  VIEW
  CLICK
}

enum AeliDevice {
  MOBILE
  TABLET
  DESKTOP
  UNKNOWN
}

/// Wie ein Besucher an die Seite kommt.
enum AeliGate {
  NONE
  /// Passwort, das der Creator vergibt.
  PASSWORD
  /// Bestaetigung "ich bin 18+" vor dem ersten Blick.
  AGE
  /// E-Mail vor dem Entsperren (erzeugt einen AeliLead).
  EMAIL
}

model AeliProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Die Subdomain: {handle}.aeli.so. 3-30 Zeichen, [a-z0-9-], nicht
  /// reserviert (siehe aeli.so/lib/handle.ts).
  handle      String  @unique
  displayName String
  bio         String?
  avatarUrl   String?
  /// Optionales Titelbild hinter dem Avatar.
  bannerUrl   String?

  /// Theme-Preset + Feintuning. Struktur: aeli.so/lib/themes.ts (AeliTheme).
  /// Json statt Spalten, weil sich hier die Gestaltung schneller bewegt als
  /// das Schema — die Bloecke selbst bleiben bewusst normalisiert.
  theme Json?

  /// Social-Profile als [{ platform, url }] — gerendert vom SOCIAL_ROW-Block
  /// und im Kopf der Seite.
  socials Json?

  status      AeliStatus @default(DRAFT)
  publishedAt DateTime?

  /// Bruecke nach Aera: gesetzt, wenn der Creator eine eigene Community
  /// verknuepft hat. COMMUNITY_CTA und LIVE_NOW brauchen das.
  linkedTenantId String?
  linkedTenant   Tenant? @relation("AeliLinkedTenant", fields: [linkedTenantId], references: [id], onDelete: SetNull)

  seoTitle       String?
  seoDescription String?
  seoImageUrl    String?
  seoNoindex     Boolean @default(false)

  /// Zugangsschranke vor der Seite.
  gate             AeliGate @default(NONE)
  /// bcrypt-Hash, nur bei gate = PASSWORD.
  gatePasswordHash String?

  /// "Meistgeklickt oben": sortiert LINK-Bloecke zur Laufzeit nach clickCount,
  /// ohne die vom Creator gesetzte Reihenfolge zu zerstoeren.
  smartSort    Boolean @default(false)
  /// Freemium: Aeli-Hinweis im Fuss. Pro (bzw. Aera PRO+) darf ihn abschalten.
  showBranding Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards  AeliCard[]
  blocks AeliBlock[]
  events AeliClick[]
  leads  AeliLead[]
  tips   AeliTip[]

  @@index([status, publishedAt])
  @@index([linkedTenantId])
}

/// Eine Karte im Stapel.
///
/// Eine Bio-Seite ist nicht mehr eine Spalte, sondern ein Stapel: „Start",
/// „Musik", „Shop" — jede Karte mit eigenen Bausteinen und optional eigenem
/// Aussehen. Der Besucher wischt zwischen ihnen, jede hat eine eigene Adresse.
///
/// `theme` ist bewusst nullbar: leer heisst „wie die Seite". Ein Stapel, bei
/// dem jede Karte ihr Theme kopiert bekommt, laesst sich nicht mehr an einer
/// Stelle umfaerben — und genau das will man, wenn man ein Design aendert.
model AeliCard {
  id        String      @id @default(cuid())
  profileId String
  profile   AeliProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Der letzte Teil der Adresse: `{handle}.aeli.so/{slug}`.
  slug  String
  /// Beschriftung des Reiters.
  title String
  /// Emoji im Reiter. Optional — ein Wort reicht meistens.
  icon  String?

  /// Eigenes Aussehen dieser Karte. Null = das der Seite.
  theme Json?

  sortOrder Int     @default(0)
  isVisible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks AeliBlock[]

  @@unique([profileId, slug])
  @@index([profileId, sortOrder])
}

model AeliBlock {
  id        String      @id @default(cuid())
  profileId String
  profile   AeliProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Auf welcher Karte der Baustein steht.
  cardId    String
  card      AeliCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)

  type     AeliBlockType
  title    String?
  subtitle String?
  href     String?
  mediaUrl String?
  /// Emoji oder Icon-Schluessel (lib/icons.ts). Bewusst ein String, kein Upload.
  icon     String?

  /// Typabhaengige Extras (Embed-Provider, Preisangabe, Formularfelder,
  /// A/B-Variante). Was jeder Typ liest, steht in aeli.so/lib/blocks.ts.
  config Json?

  sortOrder Int     @default(0)
  isVisible Boolean @default(true)

  /// Zeitfenster. Ausserhalb ist der Block unsichtbar, ohne dass jemand ihn
  /// loeschen oder ausblenden muss.
  startsAt DateTime?
  endsAt   DateTime?

  /// Denormalisierter Zaehler. Das Ereignis-Log bleibt die Wahrheit; dieser
  /// Wert existiert, damit Studio-Liste und Smart-Sort nicht bei jedem Aufruf
  /// ueber AeliClick aggregieren muessen.
  clickCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events AeliClick[]

  @@index([profileId, sortOrder])
  @@index([profileId, clickCount])
  @@index([cardId, sortOrder])
}

/// Append-only Ereignis-Log. Bewusst ohne IP und ohne Roh-User-Agent: fuer
/// "wie viele verschiedene Leute" reicht ein tagesrotierender Hash, und ohne
/// Rohdaten gibt es auch nichts, was spaeter ausgeleitet werden koennte.
model AeliClick {
  id        String      @id @default(cuid())
  profileId String
  profile   AeliProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Null bei kind = VIEW.
  blockId   String?
  block     AeliBlock?  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  kind AeliEventKind

  ts DateTime @default(now())

  /// Nur der Host der Herkunft ("instagram.com"), nie die volle URL: Pfade
  /// tragen fremde Nutzerdaten.
  referrerHost String?
  /// HMAC(uaHash) = f(UserAgent + Salt + Tag). Rotiert taeglich, nicht
  /// rueckrechenbar, taugt genau fuer "unique am selben Tag".
  visitorHash  String?
  country      String?
  device       AeliDevice @default(UNKNOWN)

  @@index([profileId, ts])
  @@index([profileId, kind, ts])
  @@index([blockId, ts])
}

/// E-Mail-/Kontakt-Einsendungen aus NEWSLETTER-, CONTACT- und EMAIL-Gate.
model AeliLead {
  id        String      @id @default(cuid())
  profileId String
  profile   AeliProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Aus welchem Block die Einsendung kam (null beim Gate).
  blockId   String?

  email   String
  name    String?
  message String?
  /// "NEWSLETTER" | "CONTACT" | "GATE" — woher der Lead stammt.
  source  String

  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([profileId, email])
}

/// Das Stripe-Konto, auf das Trinkgelder einer Bio-Seite ausgezahlt werden.
///
/// Eigene Tabelle und nicht eine Spalte auf `AeliProfile`, aus einem Grund:
/// die oeffentliche Policy auf `AeliProfile` gibt eine veroeffentlichte Zeile
/// vollstaendig heraus. Eine Kontokennung gehoert dort nicht hinein, und
/// PostgreSQL kennt keine Policy je Spalte.
///
/// Verbunden ist es mit dem KONTO, nicht mit dem Profil: es ueberlebt einen
/// Handle-Wechsel und ist dieselbe Zusage wie in Aera, wo `stripeAccountId`
/// am Tenant haengt.
model AeliPayoutAccount {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// `acct_…` derselben Stripe-Plattform, die auch Aera benutzt. Nur so kann
  /// eine Bio-Seite das Konto ihrer Aera-Community mitbenutzen.
  stripeAccountId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AeliTipStatus {
  PENDING
  PAID
  REFUNDED
}

/// Ein Trinkgeld ueber den TIP-Baustein.
///
/// Die Zeile entsteht VOR dem Bezahlen und bleibt `PENDING`, bis Stripe den
/// Abschluss meldet. Abgebrochene Zahlungen bleiben also stehen — das ist
/// gewollt: eine Zeile, die es nicht gibt, kann ein Webhook nicht finden.
model AeliTip {
  id        String      @id @default(cuid())
  profileId String
  profile   AeliProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Aus welchem Baustein — eine Seite darf mehrere haben.
  blockId   String?

  amountCents Int
  currency    String @default("eur")
  /// Optionaler Gruss. Der Absender bleibt sonst anonym.
  message     String?
  /// Nur, was Stripe zurueckmeldet; niemand tippt hier eine Adresse ein.
  supporterEmail String?

  status AeliTipStatus @default(PENDING)

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  /// Wohin das Geld ging, festgehalten zum Zeitpunkt der Zahlung. Wechselt der
  /// Creator spaeter sein Auszahlungskonto, bleibt nachvollziehbar, wohin die
  /// alten Betraege geflossen sind.
  destinationAccountId String
  platformFeeCents     Int    @default(0)

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([profileId, createdAt])
  @@index([profileId, status])
}
