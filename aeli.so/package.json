{
  "name": "aeli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-3001}",
    "build": "next build",
    "start": "next start --port ${PORT:-3001}",
    "lint": "eslint . --quiet",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:rls": "tsx scripts/check-rls.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "16.2.11",
    "pg": "^8.16.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.0",
    "stripe": "^19.0.0",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.23",
    "fast-uri": "^3.1.5",
    "valibot": "^1.4.2"
  }
}
