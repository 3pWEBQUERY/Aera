// Aeli — Spiegelschema
//
// ACHTUNG: Hier wird NICHT migriert. Die Wahrheit ueber das Datenbankschema
// steht in `../../prisma/schema.prisma` (Aera); dort liegen auch die
// Migrationen, und beide Apps sprechen mit derselben PostgreSQL-Datenbank.
//
// Diese Datei existiert nur, damit die Aeli-App einen eigenen, schlanken
// Prisma-Client bekommt. Sie enthaelt bewusst nur die Modelle, die Aeli
// tatsaechlich anfasst — Prisma braucht nicht jede Spalte einer Tabelle zu
// kennen, um sie zu lesen. Was fehlt, ist also kein Versehen, sondern die
// Zusicherung, dass diese App den Rest der Plattform nicht anfassen kann.
//
// Nach einer Schemaaenderung an den Aeli-Modellen in Aera:
//   1. Migration dort schreiben und ausrollen
//   2. den geaenderten Modellblock hierher spiegeln
//   3. `npm run prisma:generate`
// `npm run db:rls` meldet, wenn Rolle, Policies oder Grants nicht mehr passen.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url kommt aus prisma.config.ts
}

// ----------------------------------------------------------------------------
// Geteilte Identitaet (Aera-Tabellen, hier nur so weit wie noetig)
// ----------------------------------------------------------------------------

enum AccountStatus {
  ACTIVE
  DELETING
  DELETED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETING
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum Visibility {
  PUBLIC
  MEMBERS
  PAID
}

enum BillingInterval {
  FREE
  MONTH
  YEAR
  ONE_TIME
}

enum SpaceType {
  FEED
  FORUM
  COURSE
  SHOP
  NEWSLETTER
  EVENTS
  BLOG
  KNOWLEDGE
  GALLERY
  VIDEOS
  CHAT
  PODCAST
  MUSIC
  LINKS
  ADS
  LIVE
  REQUESTS
  BOOKING
  STORIES
  TIPS
  CALENDAR
}

enum ProductType {
  DIGITAL
  PHYSICAL
  BUNDLE
  COURSE_ACCESS
  TIER_GRANT
}

/// Dasselbe Konto wie auf aera.so. Wer dort registriert ist, meldet sich hier
/// mit denselben Zugangsdaten an — es gibt kein zweites Passwort.
model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String
  name            String
  avatarUrl       String?
  emailVerifiedAt DateTime?
  /// Nur zum Pruefen beim Login (lib/totp.ts). Aeli richtet Zwei-Faktor nicht
  /// ein und schreibt diese Spalte niemals.
  totpSecret      String?
  totpEnabledAt   DateTime?
  sessionVersion  Int           @default(0)
  accountStatus   AccountStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  aeliProfile       AeliProfile?
  aeliPayoutAccount AeliPayoutAccount?
  legalAcceptances  LegalAcceptance[]
  ownedTenants     Tenant[]          @relation("TenantOwner")
}

/// Nachweis, dass jemand AGB und Datenschutzhinweis zugestimmt hat. Aeli
/// schreibt hier mit `source = "AELI_SIGNUP"`.
model LegalAcceptance {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   String
  version    String
  source     String
  acceptedAt DateTime @default(now())

  @@unique([userId, document, version])
}

/// Eine Aera-Community. Aeli liest nur, und nur fuer die Bruecken-Bloecke.
///
/// ACHTUNG, Ausnahme: `ownerId` und `stripeAccountId` sind fuer die Rolle
/// `aeli_app` NICHT gewaehrt (siehe scripts/check-rls.ts). Sie stehen hier
/// trotzdem, weil beide gebraucht werden, um ein Auszahlungskonto zu bestimmen
/// — und dieser eine Weg laeuft ueber `systemPrisma`. Jede Abfrage auf `Tenant`
/// in dieser App muss deshalb ueber die privilegierte Verbindung gehen; ein
/// Test in tests/payouts.test.ts haelt das fest.
model Tenant {
  id           String       @id @default(cuid())
  name         String       @unique
  slug         String       @unique
  subdomain    String?      @unique
  customDomain String?      @unique
  tagline      String?
  logoUrl      String?
  primaryColor String       @default("#6d28d9")
  accentColor  String       @default("#ec4899")
  status       TenantStatus @default(ACTIVE)

  ownerId         String
  owner           User    @relation("TenantOwner", fields: [ownerId], references: [id])
  stripeAccountId String?

  liveSessions LiveSession[]
  aeliProfiles AeliProfile[] @relation("AeliLinkedTenant")

  spaces   Space[]
  events   Event[]
  tiers    MembershipTier[]
  products Product[]
  courses  Course[]
}

/// Nur fuer den LIVE_NOW-Block: laeuft gerade eine Uebertragung?
model LiveSession {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  status    LiveStatus @default(SCHEDULED)
  startsAt  DateTime?
  createdAt DateTime   @default(now())

  @@index([tenantId, status])
}

// ----------------------------------------------------------------------------
// Aera-Inhalte fuer die AERA_*-Bausteine
//
// Diese fuenf Modelle sind der schmalste Teil des Spiegels: sie fuehren NUR die
// Spalten, die `aeli_app` ueberhaupt gewaehrt bekommen hat (Migration
// 20260808120000_aeli_aera_blocks). Das ist kein Ordnungssinn, sondern eine
// Bremse — eine Abfrage ohne `select` zieht in Prisma alle deklarierten Felder,
// und ein Feld, das hier nicht steht, kann so auch nicht versehentlich
// angefragt werden und die Abfrage an einem fehlenden Grant zerschellen lassen.
//
// Geschrieben wird hier nie. Was sichtbar ist, entscheiden die Policies, nicht
// die `where`-Klauseln in lib/aera-content.ts.
// ----------------------------------------------------------------------------

model Space {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  type        SpaceType
  description String?
  icon        String?
  visibility  Visibility @default(MEMBERS)
  sortOrder   Int        @default(0)
  isArchived  Boolean    @default(false)

  requiredEntitlementKey String?

  events   Event[]
  products Product[]
  courses  Course[]

  @@index([tenantId])
}

model Event {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId  String
  space    Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  title       String
  slug        String
  description String?
  coverUrl    String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  isOnline    Boolean   @default(true)

  requiredEntitlementKey String?

  @@index([tenantId, startsAt])
}

model MembershipTier {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  slug          String
  description   String?
  coverUrl      String?
  isRecommended Boolean         @default(false)
  priceCents    Int             @default(0)
  currency      String          @default("eur")
  interval      BillingInterval @default(FREE)
  sortOrder     Int             @default(0)
  isPublic      Boolean         @default(true)

  @@index([tenantId])
}

model Product {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId  String?
  space    Space?  @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  name        String
  slug        String
  description String?
  coverUrl    String?
  priceCents  Int         @default(0)
  currency    String      @default("eur")
  type        ProductType @default(DIGITAL)
  isPublished Boolean     @default(true)

  @@index([tenantId])
}

model Course {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaceId  String
  space    Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  title       String
  slug        String
  description String?
  coverUrl    String?
  isPublished Boolean @default(false)

  requiredEntitlementKey String?

  @@index([tenantId, spaceId])
}

// ----------------------------------------------------------------------------
// Aeli
// ----------------------------------------------------------------------------

enum AeliStatus {
  DRAFT
  PUBLISHED
}

enum AeliBlockType {
  LINK
  HEADER
  TEXT
  SOCIAL_ROW
  DIVIDER
  EMBED
  IMAGE
  COMMUNITY_CTA
  NEWSLETTER
  TIP
  PRODUCT
  BOOKING
  LIVE_NOW
  MUSIC
  CONTACT
  QR_SHARE
  AERA_EVENTS
  AERA_TIERS
  AERA_SHOP
  AERA_COURSES
  AERA_SPACES
}

enum AeliEventKind {
  VIEW
  CLICK
}

enum AeliDevice {
  MOBILE
  TABLET
  DESKTOP
  UNKNOWN
}

enum AeliGate {
  NONE
  PASSWORD
  AGE
  EMAIL
}

model AeliProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  handle      String  @unique
  displayName String
  bio         String?
  avatarUrl   String?
  bannerUrl   String?

  theme   Json?
  socials Json?

  status      AeliStatus @default(DRAFT)
  publishedAt DateTime?

  linkedTenantId String?
  linkedTenant   Tenant? @relation("AeliLinkedTenant", fields: [linkedTenantId], references: [id], onDelete: SetNull)

  seoTitle       String?
  seoDescription String?
  seoImageUrl    String?
  seoNoindex     Boolean @default(false)

  gate             AeliGate @default(NONE)
  gatePasswordHash String?

  smartSort    Boolean @default(false)
  showBranding Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards  AeliCard[]
  blocks AeliBlock[]
  events AeliClick[]
  leads  AeliLead[]
  tips   AeliTip[]

  @@index([status, publishedAt])
  @@index([linkedTenantId])
}

/// Eine Karte im Stapel. `theme` leer heisst „wie die Seite".
model AeliCard {
  id        String      @id @default(cuid())
  profileId String
  profile   AeliProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  slug  String
  title String
  icon  String?

  theme Json?

  sortOrder Int     @default(0)
  isVisible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks AeliBlock[]

  @@unique([profileId, slug])
  @@index([profileId, sortOrder])
}

model AeliBlock {
  id        String      @id @default(cuid())
  profileId String
  profile   AeliProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  cardId    String
  card      AeliCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)

  type     AeliBlockType
  title    String?
  subtitle String?
  href     String?
  mediaUrl String?
  icon     String?
  config   Json?

  sortOrder Int     @default(0)
  isVisible Boolean @default(true)

  startsAt DateTime?
  endsAt   DateTime?

  clickCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events AeliClick[]

  @@index([profileId, sortOrder])
  @@index([profileId, clickCount])
  @@index([cardId, sortOrder])
}

model AeliClick {
  id        String      @id @default(cuid())
  profileId String
  profile   AeliProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  blockId   String?
  block     AeliBlock?  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  kind AeliEventKind

  ts DateTime @default(now())

  referrerHost String?
  visitorHash  String?
  country      String?
  device       AeliDevice @default(UNKNOWN)

  @@index([profileId, ts])
  @@index([profileId, kind, ts])
  @@index([blockId, ts])
}

enum AeliTipStatus {
  PENDING
  PAID
  REFUNDED
}

/// Das Stripe-Konto, auf das Trinkgelder ausgezahlt werden. Eigene Tabelle,
/// damit die Kontokennung nicht in der oeffentlich lesbaren `AeliProfile`-Zeile
/// steht — Begruendung in der Migration 20260809120000_aeli_tips.
model AeliPayoutAccount {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeAccountId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AeliTip {
  id        String      @id @default(cuid())
  profileId String
  profile   AeliProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  blockId   String?

  amountCents    Int
  currency       String  @default("eur")
  message        String?
  supporterEmail String?

  status AeliTipStatus @default(PENDING)

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  destinationAccountId String
  platformFeeCents     Int    @default(0)

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([profileId, createdAt])
  @@index([profileId, status])
}

model AeliLead {
  id        String      @id @default(cuid())
  profileId String
  profile   AeliProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  blockId   String?

  email   String
  name    String?
  message String?
  source  String

  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([profileId, email])
}
