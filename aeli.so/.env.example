# ---------------------------------------------------------------------------
# Aeli — aeli.so
#
# Aeli ist eine eigenstaendige Next.js-App, die auf DERSELBEN Datenbank
# arbeitet wie Aera. Variablen ohne Praefix teilt sie sich deshalb mit Aera
# (gleicher Name, gleicher Wert); alles mit AELI_ gehoert nur hierher.
#
# Migrationen laufen NIE aus diesem Ordner. Das Schema wird von Aera aus
# ausgerollt: `npm run db:deploy` im Wurzelverzeichnis.
# ---------------------------------------------------------------------------

# Dieselbe Verbindung wie bei Aera. Die Rolle darin muss `SET ROLE aeli_app`
# duerfen — das richtet die Migration 20260807120000_aeli_link_in_bio ein.
# `npm run db:rls` sagt dir, ob es stimmt.
DATABASE_URL=postgresql://user:password@host:5432/datenbank

# Signiert die Aeli-Sitzungscookies. Bewusst NICHT dasselbe wie Aeras
# AUTH_SECRET: faellt eines der beiden Produkte aus, soll das andere nicht
# mitfallen. Erzeugen mit: openssl rand -base64 48
AELI_AUTH_SECRET=

# Geht in den taeglich wechselnden Besucher-Hash ein (lib/analytics.ts). Ohne
# ihn waere der Hash ratbar, weil die Menge der User-Agents klein ist.
# Erzeugen mit: openssl rand -base64 32
AELI_VISITOR_SALT=

# Wurzeldomain. Bestimmt den Cookie-Bereich und die Adresse {handle}.aeli.so.
# Lokal auf `localhost` lassen — dann laeuft alles ueber /p/{handle}.
NEXT_PUBLIC_AELI_ROOT_DOMAIN=aeli.so

# Absolute Basis fuer Canonicals, OG-Bilder und Weiterleitungen vom Profil
# zurueck auf den Apex.
AELI_APP_URL=https://aeli.so

# --- Bruecke nach Aera ------------------------------------------------------
# Wohin ein „Community beitreten“ zeigt. Beide Werte gleich wie bei Aera.
NEXT_PUBLIC_ROOT_DOMAIN=aera.so
AERA_APP_URL=https://aera.so

# Signiert die Verbindungscodes aus Aeras Dashboard. Muss in BEIDEN Apps
# derselbe Wert sein — sonst laesst sich hier kein Code einloesen.
AELI_LINK_SECRET=

# Nur noetig, wenn sich Konten mit aktivem Zwei-Faktor hier anmelden sollen:
# derselbe Schluesselbund wie bei Aera, sonst kann Aeli den TOTP-Code nicht
# pruefen und weist diese Konten mit einem Hinweis ab.
AERA_DATA_ENCRYPTION_KEYS=

# --- Bilder -----------------------------------------------------------------
# Der EIGENE Bucket im Railway-Projekt „Aeli.so" — nicht der von Aera. Ein
# Bucket pro Produkt heisst: ein durchgesickerter Schluessel oeffnet nur die
# eigene Haelfte, und die Speicherkosten lassen sich ohne Rechnerei zuordnen.
#
# Werte holen:
#   railway link --project "Aeli.so"
#   railway bucket credentials --bucket <name> --json
#
# Fehlt einer der vier Pflichtwerte, bleibt der Bild-Upload aus (die App laeuft
# weiter, /api/upload antwortet dann mit 503).
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# „virtual-host" oder „path" — Railway meldet den passenden Stil pro Bucket.
# Der falsche liefert 404 auf jedes Objekt.
S3_URL_STYLE=virtual-host

# NUR setzen, wenn der Bucket oeffentlich lesbar ist oder ein CDN davorsteht.
# Railway-Buckets sind privat; leer lassen heisst, dass Bilder ueber
# /api/media/... ausgeliefert werden — der Weg, der dann funktioniert.
S3_PUBLIC_URL=
